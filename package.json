{
  "name": "joonassandell-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": {
    "name": "Joonas Sandell",
    "url": "https://joonassandell.com"
  },
  "packageManager": "bun@1.1.38",
  "scripts": {
    "analyze": "ANALYZE=true bun run build:ignore",
    "build:ignore": "IGNORE_ERRORS=true bun run build",
    "build": "bun run partytown && next build",
    "check": "bun run lint && bun run typecheck",
    "create:component": "bun --bun ./scripts/create-component.cjs",
    "dev": "next dev",
    "lint:fix": "next lint --fix",
    "lint": "next lint",
    "partytown": "partytown copylib public/~partytown",
    "preview:ignore": "bun run build:ignore && bun run start",
    "preview": "bun run build && bun run start",
    "start": "next start",
    "typecheck": "tsc --pretty --noEmit"
  },
  "dependencies": {
    "@nivo/line": "^0.86.0",
    "@qwik.dev/partytown": "^1.0.1",
    "clsx": "^2.1.1",
    "critters": "^0.0.25",
    "es-toolkit": "^1.52.0",
    "focus-trap-react": "^11.0.6",
    "glob": "^11.1.0",
    "lenis": "^1.3.27",
    "motion": "^11.18.2",
    "next": "^14.2.35",
    "next-themes": "^0.4.6",
    "nprogress": "^0.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-use": "^17.6.1",
    "react-use-measure": "^2.1.7",
    "sharp": "0.33.4",
    "use-resize-observer": "^9.1.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.2.35",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^22.20.5",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "autoprefixer": "^10.6.1",
    "colors": "^1.4.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-sort-destructure-keys": "^2.0.0",
    "eslint-plugin-sort-imports-es6-autofix": "^0.6.0",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "eslint-plugin-typescript-sort-keys": "^3.3.0",
    "postcss-combine-duplicated-selectors": "^10.0.3",
    "postcss-sort-media-queries": "^5.2.0",
    "prettier": "^3.9.10",
    "sass": "^1.106.0",
    "sass-mq": "^7.0.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1"
  }
}
